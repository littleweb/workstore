{
  "name": "workstore",
  "version": "0.1.20",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "node scripts/build-release.mjs --local",
    "predev": "node scripts/prepare-excalidraw.mjs && node scripts/comics/build-validator.mjs && node scripts/html-anything/build.mjs && node scripts/story-comic/build-resources.mjs && node scripts/course/build-resources.mjs && node scripts/course-animation/build-runtime.mjs && node scripts/course-whiteboard/build-runtime.mjs && node scripts/course-web/build-examples.mjs",
    "prebuild": "node scripts/prepare-excalidraw.mjs && node scripts/comics/build-validator.mjs && node scripts/html-anything/build.mjs && node scripts/story-comic/build-resources.mjs && node scripts/course/build-resources.mjs && node scripts/course-animation/build-runtime.mjs && node scripts/course-whiteboard/build-runtime.mjs && node scripts/course-web/build-examples.mjs",
    "desktop:update:build": "node scripts/build-release.mjs",
    "demo:apos": "vite --config demos/apos/vite.config.mjs",
    "demo:apos:build": "tsc -p demos/apos/tsconfig.json && vite build --config demos/apos/vite.config.mjs",
    "demo:apos:preview": "vite preview --config demos/apos/vite.config.mjs",
    "html:install": "npx --yes pnpm@10.33.2 --dir vendor/html-anything install --frozen-lockfile",
    "html:build": "node scripts/html-anything/build.mjs",
    "html:start": "node scripts/html-anything/start.mjs",
    "desktop:release:build": "node scripts/build-release.mjs",
    "covers:publish": "node scripts/covers/publish.mjs",
    "desktop:experimental:build": "tauri build",
    "design:publish": "node scripts/design-studio/publish.mjs",
    "release:check": "node scripts/release/check.mjs",
    "resources:publish": "node scripts/resources/publish.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@remotion/captions": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/player": "4.0.534",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@teabook/teaeditor": "^0.0.4",
    "@xyflow/react": "^12.11.6",
    "ajv": "^8.20.0",
    "antd": "^6.0.0",
    "jszip": "^3.10.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.534",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "26.1.0",
    "playwright": "1.61.1",
    "typescript": "~5.8.3",
    "vite": "^6.1.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.19"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/littleweb/workstore.git"
  }
}
