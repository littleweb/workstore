{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkStore Comic Template v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schemaVersion",
    "templateId",
    "revision",
    "title",
    "summary",
    "category",
    "style",
    "defaultPages",
    "supportedCounts",
    "entities",
    "beats",
    "example",
    "cover",
    "continuity",
    "source"
  ],
  "properties": {
    "type": {
      "const": "workstore.comic.template"
    },
    "schemaVersion": {
      "const": 1
    },
    "templateId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "maxLength": 3000
    },
    "category": {
      "type": "string",
      "maxLength": 40
    },
    "style": {
      "type": "string",
      "maxLength": 3000
    },
    "defaultPages": {
      "enum": [
        4,
        6,
        8
      ]
    },
    "supportedCounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          4,
          6,
          8
        ]
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "description",
          "locked"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "kind": {
            "enum": [
              "character",
              "scene",
              "prop"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 3000
          },
          "locked": {
            "type": "boolean"
          },
          "reference": {
            "type": "object",
            "required": [
              "src"
            ],
            "additionalProperties": false,
            "properties": {
              "src": {
                "type": "string",
                "maxLength": 32000000,
                "pattern": "^(?:workstore-image:[a-f0-9]{64}|/comics/[a-z0-9-]+\\.png|data:image/png;base64,[A-Za-z0-9+/=]+)$"
              },
              "crop": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 3000
      }
    },
    "example": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "action",
          "dialogue",
          "state",
          "entityIds",
          "image",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 3000
          },
          "title": {
            "type": "string",
            "maxLength": 3000
          },
          "action": {
            "type": "string",
            "maxLength": 3000
          },
          "dialogue": {
            "type": "string",
            "maxLength": 3000
          },
          "state": {
            "type": "string",
            "maxLength": 3000
          },
          "entityIds": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "image": {
            "type": "object",
            "required": [
              "src"
            ],
            "additionalProperties": false,
            "properties": {
              "src": {
                "type": "string",
                "maxLength": 32000000,
                "pattern": "^(?:workstore-image:[a-f0-9]{64}|/comics/[a-z0-9-]+\\.png|data:image/png;base64,[A-Za-z0-9+/=]+)$"
              },
              "crop": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "status": {
            "const": "ready"
          },
          "imageDialogue": {
            "type": "string",
            "maxLength": 3000
          }
        }
      }
    },
    "cover": {
      "type": "object",
      "required": [
        "src"
      ],
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string",
          "maxLength": 32000000,
          "pattern": "^(?:workstore-image:[a-f0-9]{64}|/comics/[a-z0-9-]+\\.png|data:image/png;base64,[A-Za-z0-9+/=]+)$"
        },
        "crop": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "continuity": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "string",
        "maxLength": 3000
      }
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "author",
        "redistribution"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "original",
            "authorized-reference"
          ]
        },
        "author": {
          "type": "string",
          "maxLength": 3000
        },
        "redistribution": {
          "type": "string",
          "maxLength": 3000
        },
        "referenceNotes": {
          "type": "string",
          "maxLength": 12000
        }
      }
    },
    "narrativeByCount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "4": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          }
        },
        "6": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          }
        },
        "8": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          }
        }
      },
      "required": [
        "4",
        "6",
        "8"
      ]
    },
    "publishingDirection": {
      "type": "string",
      "maxLength": 3000
    },
    "dialogueStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "position",
        "fill"
      ],
      "properties": {
        "shape": {
          "enum": [
            "speech",
            "thought"
          ]
        },
        "position": {
          "enum": [
            "top",
            "bottom",
            "auto"
          ]
        },
        "fill": {
          "enum": [
            "white",
            "cream"
          ]
        },
        "rendering": {
          "const": "integrated"
        },
        "lettering": {
          "type": "string",
          "maxLength": 3000
        }
      }
    }
  }
}
