{"cues":[{"index":1,"startMs":0,"endMs":2334,"durMs":2334,"text":"想象一滴水落进小池塘"},{"index":2,"startMs":2334,"endMs":4145,"durMs":1811,"text":"它的旅行才刚开始"},{"index":3,"startMs":4145,"endMs":6158,"durMs":2013,"text":"太阳把能量带到水面"},{"index":4,"startMs":6158,"endMs":8774,"durMs":2616,"text":"部分水变成看不见的水蒸气"},{"index":5,"startMs":8774,"endMs":10988,"durMs":2214,"text":"蒸发可以发生在常温下"},{"index":6,"startMs":10988,"endMs":12397,"durMs":1409,"text":"不必等水沸腾"},{"index":7,"startMs":12397,"endMs":14611,"durMs":2214,"text":"小实验：观察同样的水"},{"index":8,"startMs":14611,"endMs":30000,"durMs":15389,"text":"放在不同位置有什么变化"},{"index":9,"startMs":30000,"endMs":32331,"durMs":2331,"text":"水蒸气来到较冷的地方"},{"index":10,"startMs":32331,"endMs":34140,"durMs":1809,"text":"可能凝结成小水滴"},{"index":11,"startMs":34140,"endMs":36552,"durMs":2412,"text":"云里聚集着小水滴或冰晶"},{"index":12,"startMs":36552,"endMs":38361,"durMs":1809,"text":"云不是一团水蒸气"},{"index":13,"startMs":38361,"endMs":39768,"durMs":1407,"text":"水滴不断碰合"},{"index":14,"startMs":39768,"endMs":42180,"durMs":2412,"text":"变大后可能落下来形成雨"},{"index":15,"startMs":42180,"endMs":45397,"durMs":3217,"text":"回想一下：看到云和看不到水蒸气"},{"index":16,"startMs":45397,"endMs":60000,"durMs":14603,"text":"有什么区别"},{"index":17,"startMs":60000,"endMs":61269,"durMs":1269,"text":"落下来的雨"},{"index":18,"startMs":61269,"endMs":63567,"durMs":2298,"text":"有一部分流入河流和湖泊"},{"index":19,"startMs":63567,"endMs":65290,"durMs":1723,"text":"还有一些进入土壤"},{"index":20,"startMs":65290,"endMs":66630,"durMs":1340,"text":"补充地下的水"},{"index":21,"startMs":66630,"endMs":68353,"durMs":1723,"text":"植物从土壤中吸水"},{"index":22,"startMs":68353,"endMs":69885,"durMs":1532,"text":"也把水带回空气"},{"index":23,"startMs":69885,"endMs":71608,"durMs":1723,"text":"不同路径连在一起"},{"index":24,"startMs":71608,"endMs":90000,"durMs":18392,"text":"水循环没有唯一的起点"},{"index":25,"startMs":90000,"endMs":91342,"durMs":1342,"text":"用自己的话"},{"index":26,"startMs":91342,"endMs":94601,"durMs":3259,"text":"把蒸发、凝结和降水连成一次旅行"},{"index":27,"startMs":94601,"endMs":96230,"durMs":1629,"text":"遇到太阳和水面"},{"index":28,"startMs":96230,"endMs":98064,"durMs":1834,"text":"就想起能量与蒸发"},{"index":29,"startMs":98064,"endMs":100101,"durMs":2037,"text":"遇到冷空气和小水滴"},{"index":30,"startMs":100101,"endMs":101323,"durMs":1222,"text":"就想起凝结"},{"index":31,"startMs":101323,"endMs":104175,"durMs":2852,"text":"练习：雨停之后地面慢慢变干"},{"index":32,"startMs":104175,"endMs":120000,"durMs":15825,"text":"水可能去了哪里"}],"scenes":[{"sceneIndex":1,"startMs":0,"endMs":30000,"sceneDurationMs":30000,"cueRange":[1,8],"text":"想象一滴水落进小池塘 它的旅行才刚开始 太阳把能量带到水面 部分水变成看不见的水蒸气 蒸发可以发生在常温下 不必等水沸腾 小实验：观察同样的水 放在不同位置有什么变化"},{"sceneIndex":2,"startMs":30000,"endMs":60000,"sceneDurationMs":30000,"cueRange":[9,16],"text":"水蒸气来到较冷的地方 可能凝结成小水滴 云里聚集着小水滴或冰晶 云不是一团水蒸气 水滴不断碰合 变大后可能落下来形成雨 回想一下：看到云和看不到水蒸气 有什么区别"},{"sceneIndex":3,"startMs":60000,"endMs":90000,"sceneDurationMs":30000,"cueRange":[17,24],"text":"落下来的雨 有一部分流入河流和湖泊 还有一些进入土壤 补充地下的水 植物从土壤中吸水 也把水带回空气 不同路径连在一起 水循环没有唯一的起点"},{"sceneIndex":4,"startMs":90000,"endMs":120000,"sceneDurationMs":30000,"cueRange":[25,32],"text":"用自己的话 把蒸发、凝结和降水连成一次旅行 遇到太阳和水面 就想起能量与蒸发 遇到冷空气和小水滴 就想起凝结 练习：雨停之后地面慢慢变干 水可能去了哪里"}]}