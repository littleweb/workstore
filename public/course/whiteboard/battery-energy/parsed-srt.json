{"cues":[{"index":1,"startMs":0,"endMs":4253,"durMs":4253,"text":"电池把内部储存的化学能转成可以使用的电能"},{"index":2,"startMs":4253,"endMs":5828,"durMs":1575,"text":"它有两个连接端"},{"index":3,"startMs":5828,"endMs":8582,"durMs":2754,"text":"电路要把两端连进完整的路径"},{"index":4,"startMs":8582,"endMs":10550,"durMs":1968,"text":"只把一根线碰到灯上"},{"index":5,"startMs":10550,"endMs":12715,"durMs":2165,"text":"通常不能形成完整回路"},{"index":6,"startMs":12715,"endMs":15274,"durMs":2559,"text":"先记住能量来源和完整路径"},{"index":7,"startMs":15274,"endMs":30000,"durMs":14726,"text":"再看内部怎么工作"},{"index":8,"startMs":30000,"endMs":32158,"durMs":2158,"text":"电池内部有不同材料"},{"index":9,"startMs":32158,"endMs":34196,"durMs":2038,"text":"它们能参与化学反应"},{"index":10,"startMs":34196,"endMs":36031,"durMs":1835,"text":"反应推动电荷移动"},{"index":11,"startMs":36031,"endMs":37865,"durMs":1834,"text":"形成两端的电势差"},{"index":12,"startMs":37865,"endMs":41330,"durMs":3465,"text":"材料和结构决定不同电池的使用特点"},{"index":13,"startMs":41330,"endMs":42757,"durMs":1427,"text":"这是简化模型"},{"index":14,"startMs":42757,"endMs":60000,"durMs":17243,"text":"真实电池的具体反应并不完全相同"},{"index":15,"startMs":60000,"endMs":61698,"durMs":1698,"text":"把小灯连成回路"},{"index":16,"startMs":61698,"endMs":64065,"durMs":2367,"text":"电池就能向电路提供能量"},{"index":17,"startMs":64065,"endMs":66039,"durMs":1974,"text":"能量在小灯处变成光"},{"index":18,"startMs":66039,"endMs":67814,"durMs":1775,"text":"也有一部分变成热"},{"index":19,"startMs":67814,"endMs":70576,"durMs":2762,"text":"导线上的电荷不是被灯泡吃掉"},{"index":20,"startMs":70576,"endMs":72351,"durMs":1775,"text":"它们持续参与回路"},{"index":21,"startMs":72351,"endMs":74324,"durMs":1973,"text":"练习：断开一处连接"},{"index":22,"startMs":74324,"endMs":90000,"durMs":15676,"text":"为什么灯通常会熄灭"},{"index":23,"startMs":90000,"endMs":91314,"durMs":1314,"text":"使用过程中"},{"index":24,"startMs":91314,"endMs":94101,"durMs":2787,"text":"能参与反应的材料状态会改变"},{"index":25,"startMs":94101,"endMs":96092,"durMs":1991,"text":"继续供电的能力下降"},{"index":26,"startMs":96092,"endMs":98281,"durMs":2189,"text":"我们就说电池快用完了"},{"index":27,"startMs":98281,"endMs":99874,"durMs":1593,"text":"有些电池能充电"},{"index":28,"startMs":99874,"endMs":102064,"durMs":2190,"text":"有些不能随意再次充电"},{"index":29,"startMs":102064,"endMs":103457,"durMs":1393,"text":"判断能否充电"},{"index":30,"startMs":103457,"endMs":104851,"durMs":1394,"text":"应看产品说明"},{"index":31,"startMs":104851,"endMs":120000,"durMs":15149,"text":"不靠外形猜测"},{"index":32,"startMs":120000,"endMs":123087,"durMs":3087,"text":"不要把电池两端直接用金属连接"},{"index":33,"startMs":123087,"endMs":124472,"durMs":1385,"text":"这会造成短路"},{"index":34,"startMs":124472,"endMs":126055,"durMs":1583,"text":"不拆开、不加热"},{"index":35,"startMs":126055,"endMs":128626,"durMs":2571,"text":"也不要混用不同状态的电池"},{"index":36,"startMs":128626,"endMs":131198,"durMs":2572,"text":"不用的电池按当地要求收集"},{"index":37,"startMs":131198,"endMs":132583,"durMs":1385,"text":"避免随手丢弃"},{"index":38,"startMs":132583,"endMs":134561,"durMs":1978,"text":"这里只解释工作原理"},{"index":39,"startMs":134561,"endMs":150000,"durMs":15439,"text":"不演示拆电池或危险实验"},{"index":40,"startMs":150000,"endMs":152352,"durMs":2352,"text":"电池利用内部化学变化"},{"index":41,"startMs":152352,"endMs":154382,"durMs":2030,"text":"为完整电路提供电能"},{"index":42,"startMs":154382,"endMs":155396,"durMs":1014,"text":"灯亮不亮"},{"index":43,"startMs":155396,"endMs":158237,"durMs":2841,"text":"要同时看电池、连接和用电器"},{"index":44,"startMs":158237,"endMs":159454,"durMs":1217,"text":"当灯不亮时"},{"index":45,"startMs":159454,"endMs":162295,"durMs":2841,"text":"先从说明允许的安全检查开始"},{"index":46,"startMs":162295,"endMs":164527,"durMs":2232,"text":"练习：电池放进手电筒"},{"index":47,"startMs":164527,"endMs":180000,"durMs":15473,"text":"为什么还需要打开开关"}],"scenes":[{"sceneIndex":1,"startMs":0,"endMs":30000,"sceneDurationMs":30000,"cueRange":[1,7],"text":"电池把内部储存的化学能转成可以使用的电能 它有两个连接端 电路要把两端连进完整的路径 只把一根线碰到灯上 通常不能形成完整回路 先记住能量来源和完整路径 再看内部怎么工作"},{"sceneIndex":2,"startMs":30000,"endMs":60000,"sceneDurationMs":30000,"cueRange":[8,14],"text":"电池内部有不同材料 它们能参与化学反应 反应推动电荷移动 形成两端的电势差 材料和结构决定不同电池的使用特点 这是简化模型 真实电池的具体反应并不完全相同"},{"sceneIndex":3,"startMs":60000,"endMs":90000,"sceneDurationMs":30000,"cueRange":[15,22],"text":"把小灯连成回路 电池就能向电路提供能量 能量在小灯处变成光 也有一部分变成热 导线上的电荷不是被灯泡吃掉 它们持续参与回路 练习：断开一处连接 为什么灯通常会熄灭"},{"sceneIndex":4,"startMs":90000,"endMs":120000,"sceneDurationMs":30000,"cueRange":[23,31],"text":"使用过程中 能参与反应的材料状态会改变 继续供电的能力下降 我们就说电池快用完了 有些电池能充电 有些不能随意再次充电 判断能否充电 应看产品说明 不靠外形猜测"},{"sceneIndex":5,"startMs":120000,"endMs":150000,"sceneDurationMs":30000,"cueRange":[32,39],"text":"不要把电池两端直接用金属连接 这会造成短路 不拆开、不加热 也不要混用不同状态的电池 不用的电池按当地要求收集 避免随手丢弃 这里只解释工作原理 不演示拆电池或危险实验"},{"sceneIndex":6,"startMs":150000,"endMs":180000,"sceneDurationMs":30000,"cueRange":[40,47],"text":"电池利用内部化学变化 为完整电路提供电能 灯亮不亮 要同时看电池、连接和用电器 当灯不亮时 先从说明允许的安全检查开始 练习：电池放进手电筒 为什么还需要打开开关"}]}