{"cues":[{"index":1,"startMs":0,"endMs":1726,"durMs":1726,"text":"今天用简单电路"},{"index":2,"startMs":1726,"endMs":3733,"durMs":2007,"text":"理解小灯为什么会亮"},{"index":3,"startMs":3733,"endMs":6343,"durMs":2610,"text":"只讨论合适的低压教学器材"},{"index":4,"startMs":6343,"endMs":7748,"durMs":1405,"text":"不接家庭电源"},{"index":5,"startMs":7748,"endMs":9956,"durMs":2208,"text":"观察电源、导线和小灯"},{"index":6,"startMs":9956,"endMs":11562,"durMs":1606,"text":"先认识三个部分"},{"index":7,"startMs":11562,"endMs":14171,"durMs":2609,"text":"带着问题开始：少了哪一段"},{"index":8,"startMs":14171,"endMs":30000,"durMs":15829,"text":"小灯就会熄灭"},{"index":9,"startMs":30000,"endMs":33137,"durMs":3137,"text":"电源两端通过导线和用电器连接"},{"index":10,"startMs":33137,"endMs":34546,"durMs":1409,"text":"才能形成回路"},{"index":11,"startMs":34546,"endMs":36155,"durMs":1609,"text":"路线看起来挨着"},{"index":12,"startMs":36155,"endMs":38166,"durMs":2011,"text":"不等于接点真的接通"},{"index":13,"startMs":38166,"endMs":39977,"durMs":1811,"text":"轻轻检查安全接点"},{"index":14,"startMs":39977,"endMs":42189,"durMs":2212,"text":"观察导线是否实际接触"},{"index":15,"startMs":42189,"endMs":44402,"durMs":2213,"text":"练习：把一个接点拿开"},{"index":16,"startMs":44402,"endMs":60000,"durMs":15598,"text":"整个路径发生什么变化"},{"index":17,"startMs":60000,"endMs":62284,"durMs":2284,"text":"开关控制回路是否接通"},{"index":18,"startMs":62284,"endMs":64055,"durMs":1771,"text":"不是凭空制造电能"},{"index":19,"startMs":64055,"endMs":65038,"durMs":983,"text":"开关闭合"},{"index":20,"startMs":65038,"endMs":66612,"durMs":1574,"text":"导电路径连起来"},{"index":21,"startMs":66612,"endMs":67989,"durMs":1377,"text":"小灯可能亮起"},{"index":22,"startMs":67989,"endMs":68972,"durMs":983,"text":"开关打开"},{"index":23,"startMs":68972,"endMs":69956,"durMs":984,"text":"路径中断"},{"index":24,"startMs":69956,"endMs":72120,"durMs":2164,"text":"普通电路中的灯会熄灭"},{"index":25,"startMs":72120,"endMs":73694,"durMs":1574,"text":"找到开关的位置"},{"index":26,"startMs":73694,"endMs":90000,"durMs":16306,"text":"再说清楚它控制的哪一段路径"},{"index":27,"startMs":90000,"endMs":92910,"durMs":2910,"text":"把电流理解成电荷的定向运动"},{"index":28,"startMs":92910,"endMs":94503,"durMs":1593,"text":"是一种入门描述"},{"index":29,"startMs":94503,"endMs":96495,"durMs":1992,"text":"电池向电路提供能量"},{"index":30,"startMs":96495,"endMs":98688,"durMs":2193,"text":"小灯把能量转成光和热"},{"index":31,"startMs":98688,"endMs":101278,"durMs":2590,"text":"电荷没有在灯泡里全部消失"},{"index":32,"startMs":101278,"endMs":102872,"durMs":1594,"text":"它们仍参与回路"},{"index":33,"startMs":102872,"endMs":104666,"durMs":1794,"text":"类比可以帮助理解"},{"index":34,"startMs":104666,"endMs":120000,"durMs":15334,"text":"但不要把导线想成真实水管"},{"index":35,"startMs":120000,"endMs":123334,"durMs":3334,"text":"把两个小灯依次接在同一条路径上"},{"index":36,"startMs":123334,"endMs":124740,"durMs":1406,"text":"就是简单串联"},{"index":37,"startMs":124740,"endMs":127753,"durMs":3013,"text":"只有一条主要通过用电器的路径"},{"index":38,"startMs":127753,"endMs":129159,"durMs":1406,"text":"元件首尾相接"},{"index":39,"startMs":129159,"endMs":130565,"durMs":1406,"text":"断开其中一处"},{"index":40,"startMs":130565,"endMs":133176,"durMs":2611,"text":"整个串联路径都会受到影响"},{"index":41,"startMs":133176,"endMs":135385,"durMs":2209,"text":"练习：另一只灯也熄灭"},{"index":42,"startMs":135385,"endMs":150000,"durMs":14615,"text":"怎样用路径来解释"},{"index":43,"startMs":150000,"endMs":152506,"durMs":2506,"text":"并联让电路形成不同支路"},{"index":44,"startMs":152506,"endMs":154694,"durMs":2188,"text":"各支路连接到共同两端"},{"index":45,"startMs":154694,"endMs":156881,"durMs":2187,"text":"电荷可以经过不同支路"},{"index":46,"startMs":156881,"endMs":158671,"durMs":1790,"text":"结构与串联不相同"},{"index":47,"startMs":158671,"endMs":160262,"durMs":1591,"text":"只断开一条支路"},{"index":48,"startMs":160262,"endMs":162848,"durMs":2586,"text":"另一条完整支路仍可能工作"},{"index":49,"startMs":162848,"endMs":164439,"durMs":1591,"text":"判断串联或并联"},{"index":50,"startMs":164439,"endMs":180000,"durMs":15561,"text":"追踪路径比看摆放位置更可靠"},{"index":51,"startMs":180000,"endMs":183490,"durMs":3490,"text":"如果直接把电源两端用低阻导体连接"},{"index":52,"startMs":183490,"endMs":184878,"durMs":1388,"text":"可能发生短路"},{"index":53,"startMs":184878,"endMs":186860,"durMs":1982,"text":"短路可能让电流过大"},{"index":54,"startMs":186860,"endMs":188446,"durMs":1586,"text":"导致发热和损坏"},{"index":55,"startMs":188446,"endMs":190825,"durMs":2379,"text":"教学器材也要按说明使用"},{"index":56,"startMs":190825,"endMs":192609,"durMs":1784,"text":"不能随意尝试短接"},{"index":57,"startMs":192609,"endMs":193600,"durMs":991,"text":"遇到异常"},{"index":58,"startMs":193600,"endMs":194789,"durMs":1189,"text":"先停止使用"},{"index":59,"startMs":194789,"endMs":210000,"durMs":15211,"text":"再按说明处理"},{"index":60,"startMs":210000,"endMs":212149,"durMs":2149,"text":"电路图强调连接关系"},{"index":61,"startMs":212149,"endMs":214380,"durMs":2231,"text":"不要求外形和实物一样"},{"index":62,"startMs":214380,"endMs":216003,"durMs":1623,"text":"沿路径逐个检查"},{"index":63,"startMs":216003,"endMs":218438,"durMs":2435,"text":"找到电源、开关和用电器"},{"index":64,"startMs":218438,"endMs":220467,"durMs":2029,"text":"导线交叉不一定连接"},{"index":65,"startMs":220467,"endMs":222495,"durMs":2028,"text":"要看图中的连接标记"},{"index":66,"startMs":222495,"endMs":225335,"durMs":2840,"text":"练习：同一回路换个摆放形状"},{"index":67,"startMs":225335,"endMs":240000,"durMs":14665,"text":"性质会改变吗"},{"index":68,"startMs":240000,"endMs":241946,"durMs":1946,"text":"一个低压小灯不亮"},{"index":69,"startMs":241946,"endMs":243974,"durMs":2028,"text":"先确认开关是否闭合"},{"index":70,"startMs":243974,"endMs":246408,"durMs":2434,"text":"再查看安全接点是否松动"},{"index":71,"startMs":246408,"endMs":248640,"durMs":2232,"text":"以及元件是否符合说明"},{"index":72,"startMs":248640,"endMs":252291,"durMs":3651,"text":"不要用短接电池或家庭插座来验证猜想"},{"index":73,"startMs":252291,"endMs":254928,"durMs":2637,"text":"每次只改变一个允许的条件"},{"index":74,"startMs":254928,"endMs":270000,"durMs":15072,"text":"记录观察到的结果"},{"index":75,"startMs":270000,"endMs":272924,"durMs":2924,"text":"完整路径、电源和合适用电器"},{"index":76,"startMs":272924,"endMs":274926,"durMs":2002,"text":"共同让简单电路工作"},{"index":77,"startMs":274926,"endMs":276928,"durMs":2002,"text":"开关决定接通与断开"},{"index":78,"startMs":276928,"endMs":278931,"durMs":2003,"text":"串并联决定路径结构"},{"index":79,"startMs":278931,"endMs":280734,"durMs":1803,"text":"电流描述电荷运动"},{"index":80,"startMs":280734,"endMs":283537,"durMs":2803,"text":"能量转换解释小灯发光与发热"},{"index":81,"startMs":283537,"endMs":285940,"durMs":2403,"text":"用自己的话解释一次断路"},{"index":82,"startMs":285940,"endMs":300000,"durMs":14060,"text":"你就完成了今天的练习"}],"scenes":[{"sceneIndex":1,"startMs":0,"endMs":30000,"sceneDurationMs":30000,"cueRange":[1,8],"text":"今天用简单电路 理解小灯为什么会亮 只讨论合适的低压教学器材 不接家庭电源 观察电源、导线和小灯 先认识三个部分 带着问题开始：少了哪一段 小灯就会熄灭"},{"sceneIndex":2,"startMs":30000,"endMs":60000,"sceneDurationMs":30000,"cueRange":[9,16],"text":"电源两端通过导线和用电器连接 才能形成回路 路线看起来挨着 不等于接点真的接通 轻轻检查安全接点 观察导线是否实际接触 练习：把一个接点拿开 整个路径发生什么变化"},{"sceneIndex":3,"startMs":60000,"endMs":90000,"sceneDurationMs":30000,"cueRange":[17,26],"text":"开关控制回路是否接通 不是凭空制造电能 开关闭合 导电路径连起来 小灯可能亮起 开关打开 路径中断 普通电路中的灯会熄灭 找到开关的位置 再说清楚它控制的哪一段路径"},{"sceneIndex":4,"startMs":90000,"endMs":120000,"sceneDurationMs":30000,"cueRange":[27,34],"text":"把电流理解成电荷的定向运动 是一种入门描述 电池向电路提供能量 小灯把能量转成光和热 电荷没有在灯泡里全部消失 它们仍参与回路 类比可以帮助理解 但不要把导线想成真实水管"},{"sceneIndex":5,"startMs":120000,"endMs":150000,"sceneDurationMs":30000,"cueRange":[35,42],"text":"把两个小灯依次接在同一条路径上 就是简单串联 只有一条主要通过用电器的路径 元件首尾相接 断开其中一处 整个串联路径都会受到影响 练习：另一只灯也熄灭 怎样用路径来解释"},{"sceneIndex":6,"startMs":150000,"endMs":180000,"sceneDurationMs":30000,"cueRange":[43,50],"text":"并联让电路形成不同支路 各支路连接到共同两端 电荷可以经过不同支路 结构与串联不相同 只断开一条支路 另一条完整支路仍可能工作 判断串联或并联 追踪路径比看摆放位置更可靠"},{"sceneIndex":7,"startMs":180000,"endMs":210000,"sceneDurationMs":30000,"cueRange":[51,59],"text":"如果直接把电源两端用低阻导体连接 可能发生短路 短路可能让电流过大 导致发热和损坏 教学器材也要按说明使用 不能随意尝试短接 遇到异常 先停止使用 再按说明处理"},{"sceneIndex":8,"startMs":210000,"endMs":240000,"sceneDurationMs":30000,"cueRange":[60,67],"text":"电路图强调连接关系 不要求外形和实物一样 沿路径逐个检查 找到电源、开关和用电器 导线交叉不一定连接 要看图中的连接标记 练习：同一回路换个摆放形状 性质会改变吗"},{"sceneIndex":9,"startMs":240000,"endMs":270000,"sceneDurationMs":30000,"cueRange":[68,74],"text":"一个低压小灯不亮 先确认开关是否闭合 再查看安全接点是否松动 以及元件是否符合说明 不要用短接电池或家庭插座来验证猜想 每次只改变一个允许的条件 记录观察到的结果"},{"sceneIndex":10,"startMs":270000,"endMs":300000,"sceneDurationMs":30000,"cueRange":[75,82],"text":"完整路径、电源和合适用电器 共同让简单电路工作 开关决定接通与断开 串并联决定路径结构 电流描述电荷运动 能量转换解释小灯发光与发热 用自己的话解释一次断路 你就完成了今天的练习"}]}