{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkStore",
  "version": "0.1.9",
  "identifier": "com.workstore.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorkStore",
        "visible": false,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; worker-src 'self' blob:; frame-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "html-runtime/app.tar": "html-runtime/app.tar",
      "html-runtime/node": "html-runtime/node",
      "html-runtime/preload.cjs": "html-runtime/preload.cjs",
      "html-runtime/manifest.json": "html-runtime/manifest.json",
      "html-runtime/HTML-ANYTHING-LICENSE": "html-runtime/HTML-ANYTHING-LICENSE",
      "html-runtime/NODE-LICENSE": "html-runtime/NODE-LICENSE"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxNThEMTVBNkUyQTFDODIKUldTQ0hDcHVXdEZZa1lNYnhSbHp0d3hxMXpNOGlKUDZ4YWY3V21KNEQ1YTMzQUphZkM2anROK1cK",
      "endpoints": [
        "https://github.com/littleweb/workstore/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
